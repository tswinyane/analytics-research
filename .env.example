APP_NAME=UP Research Analytics
API_PORT=8000
FRONTEND_PORT=3000

# Docker Compose exposes MySQL on MYSQL_HOST_PORT externally.
# Inside Docker, docker-compose.yml overrides MYSQL_HOST=mysql and MYSQL_PORT=3306.
MYSQL_HOST=localhost
MYSQL_HOST_PORT=3306
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=change-me
MYSQL_DATABASE=up_research_analytics

HARVEST_DEFAULT_LIMIT=100
HARVEST_SCHEDULE_HOUR=2
HARVEST_SCHEDULE_MINUTE=0
RUN_HARVEST_ON_STARTUP=false
INIT_DB_ON_STARTUP=false

OPENALEX_BASE_URL=https://api.openalex.org/works
OPENALEX_INSTITUTION_ID=I69552723
OPENALEX_API_KEY=
OPENALEX_PER_PAGE=50
OPENALEX_MAILTO=
OPENALEX_REQUEST_DELAY_SECONDS=0.25
OPENALEX_MAX_ATTEMPTS=8
OPENALEX_RETRY_AFTER_MAX_SECONDS=60
OPENALEX_TITLE_ENRICHMENT_LIMIT=0
OPENALEX_INSTITUTION_HARVEST=true

ORCID_BASE_URL=https://pub.orcid.org/v3.0
ORCID_OAUTH_TOKEN_URL=https://orcid.org/oauth/token
ORCID_AUTHORIZE_URL=https://orcid.org/oauth/authorize
ORCID_CLIENT_ID=
ORCID_CLIENT_SECRET=
ORCID_REDIRECT_URI=
ORCID_ACCESS_TOKEN=
ORCID_ORGANIZATION_NAME=University of Pretoria
ORCID_ORGANIZATION_ROR=
ORCID_PER_PAGE=50
ORCID_REQUEST_DELAY_SECONDS=0.5
ORCID_MAX_ATTEMPTS=5
ORCID_RETRY_AFTER_MAX_SECONDS=60
ORCID_RESEARCHERS_PER_RUN=0

SCOPUS_BASE_URL=https://api.elsevier.com/content/search/scopus
SCOPUS_API_KEY=
SCOPUS_AFFILIATION_ID=60022195

WOS_BASE_URL=https://api.clarivate.com/apis/wos-starter/v1/documents
WOS_API_KEY=
WOS_ORGANIZATION=University of Pretoria

DSPACE_ENDPOINT=https://repository.up.ac.za/server/oai/request
DSPACE_METADATA_PREFIX=oai_dc
DSPACE_SET_SPEC=
